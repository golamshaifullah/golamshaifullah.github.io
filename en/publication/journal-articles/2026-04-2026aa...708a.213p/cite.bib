@article{2026A&A...708A.213P,

	year = {2026},

	volume = {708},

	title = {Radio timing constraints on the orbital orientation and component masses of PSR J1455&amp;minus;3330},

	pages = {A213},

	month = {04},

	journal = {Astronomy and Astrophysics},

	doi = {10.1051/0004-6361/202556766},

	author = {Pillay, D. S. and Venkatraman Krishnan, V. and Champion, D. J. and Freire, P. C. C. and Kramer, M. and Guillemot, L. and Bailes, M. and Corongiu, A. and Geyer, M. and Singha, J. and Shannon, R. M. and Theureau, G. and Cognard, I. and Keith, M. J. and Stappers, B. W. and Antoniadis, J. and Liu, K. and Shaifullah, G. M.},

	abstract = {PSR J1455&amp;minus;3330 is a &amp;sim;7.98 ms pulsar in a &amp;sim;76.17 day nearly circular orbit with a white dwarf companion. In this work, we combine the available Lovell, Nan&#231;ay decimetric Radio Telescope, Green Bank, and MeerKAT pulsar timing data spanning approximately 30 years to measure the kinematic and relativistic effects of PSR J1455&amp;minus;3330 to constrain its 3D orbital geometry and component masses. We detect a relativistic Shapiro delay signal. We measure a significant orthometric amplitude of <inline-formula> h<SUB>3</SUB> = 0.307<SUP>+0.022</SUP><SUB>&amp;minus;0.026</SUB> <mml:math> <mml:mrow> <mml:msub> <mml:mi>h</mml:mi> <mml:mn>3</mml:mn> </mml:msub> <mml:mo>=</mml:mo> <mml:mn>0</mml:mn> <mml:mo>.</mml:mo> <mml:msubsup> <mml:mn>307</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>0.026</mml:mn> </mml:mrow> <mml:mrow> <mml:mo>+</mml:mo> <mml:mn>0.022</mml:mn> </mml:mrow> </mml:msubsup> </mml:mrow> </mml:math> </inline-formula> &amp;mu;s and an orthometric ratio of <inline-formula> &amp;sigma; = 0.551<SUP>+0.057</SUP><SUB>&amp;minus;0.054</SUB> <mml:math> <mml:mrow> <mml:mi>&amp;sigma;</mml:mi> <mml:mo>=</mml:mo> <mml:mn>0</mml:mn> <mml:mo>.</mml:mo> <mml:msubsup> <mml:mn>551</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>0.054</mml:mn> </mml:mrow> <mml:mrow> <mml:mo>+</mml:mo> <mml:mn>0.057</mml:mn> </mml:mrow> </mml:msubsup> </mml:mrow> </mml:math> </inline-formula>. We measured the change in projected semi-major axis, <inline-formula> x&#729; = &amp;minus;202.1<SUP>+2.5</SUP><SUB>&amp;minus;2.7</SUB> &amp;times; 10<SUP>&amp;minus;16</SUP> s s<SUP>&amp;minus;1</SUP> <mml:math> <mml:mrow> <mml:mover> <mml:mi>x</mml:mi> <mml:mo>&#729;</mml:mo> </mml:mover> <mml:mo>=</mml:mo> <mml:mo>&amp;minus;</mml:mo> <mml:mn>202</mml:mn> <mml:mo>.</mml:mo> <mml:msubsup> <mml:mn>1</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>2.7</mml:mn> </mml:mrow> <mml:mrow> <mml:mo>+</mml:mo> <mml:mn>2.5</mml:mn> </mml:mrow> </mml:msubsup> <mml:mo>&amp;times;</mml:mo> <mml:msup> <mml:mn>10</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>16</mml:mn> </mml:mrow> </mml:msup> <mml:mspace></mml:mspace> <mml:msup> <mml:mrow> <mml:mi>s</mml:mi> <mml:mspace></mml:mspace> <mml:mi>s</mml:mi> </mml:mrow> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>1</mml:mn> </mml:mrow> </mml:msup> </mml:mrow> </mml:math> </inline-formula>, with high significance, parallax, &amp;pi; = 1.11&lpar;6&rpar; mas, parallax derived distance 0.90&lpar;5&rpar; kpc, and a precise total proper motion magnitude of 12.432&lpar;2&rpar; mas yr<SUP>&amp;minus;1</SUP>. A self-consistent analysis of all kinematic and relativistic effects, assuming general relativity, yielded two solutions: &lpar;1&rpar; a pulsar mass of <inline-formula> M<SUB>p</SUB> = 1.39<SUP>+0.38</SUP><SUB>&amp;minus;0.18</SUB> M<SUB>&#8857;</SUB> <mml:math> <mml:mrow> <mml:msub> <mml:mi>M</mml:mi> <mml:mi>p</mml:mi> </mml:msub> <mml:mo>=</mml:mo> <mml:mn>1</mml:mn> <mml:mo>.</mml:mo> <mml:msubsup> <mml:mn>39</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>0.18</mml:mn> </mml:mrow> <mml:mrow> <mml:mo>+</mml:mo> <mml:mn>0.38</mml:mn> </mml:mrow> </mml:msubsup> <mml:mspace></mml:mspace> <mml:msub> <mml:mi>M</mml:mi> <mml:mo>&#8857;</mml:mo> </mml:msub> </mml:mrow> </mml:math> </inline-formula>, a companion mass of <inline-formula> M<SUB>c</SUB> = 0.293<SUP>+0.056</SUP><SUB>&amp;minus;0.026</SUB> <mml:math> <mml:mrow> <mml:msub> <mml:mi>M</mml:mi> <mml:mi>c</mml:mi> </mml:msub> <mml:mo>=</mml:mo> <mml:mn>0</mml:mn> <mml:mo>.</mml:mo> <mml:msubsup> <mml:mn>293</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>0.026</mml:mn> </mml:mrow> <mml:mrow> <mml:mo>+</mml:mo> <mml:mn>0.056</mml:mn> </mml:mrow> </mml:msubsup> </mml:mrow> </mml:math> </inline-formula> M<SUB>&#8857;</SUB>, an orbital inclination of i = 63&lpar;2&rpar;&#176;, and a longitude of the ascending node of &amp;Omega; = 212&lpar;12&rpar;&#176; or &lpar;2&rpar; a pulsar mass of <inline-formula> M<SUB>p</SUB> = 1.53<SUP>+1.10</SUP><SUB>&amp;minus;0.22</SUB> M<SUB>&#8857;</SUB> <mml:math> <mml:mrow> <mml:msub> <mml:mi>M</mml:mi> <mml:mi>p</mml:mi> </mml:msub> <mml:mo>=</mml:mo> <mml:mn>1</mml:mn> <mml:mo>.</mml:mo> <mml:msubsup> <mml:mn>53</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>0.22</mml:mn> </mml:mrow> <mml:mrow> <mml:mo>+</mml:mo> <mml:mn>1.10</mml:mn> </mml:mrow> </mml:msubsup> <mml:mspace></mml:mspace> <mml:msub> <mml:mi>M</mml:mi> <mml:mo>&#8857;</mml:mo> </mml:msub> </mml:mrow> </mml:math> </inline-formula>, a companion mass of <inline-formula> M<SUB>c</SUB> = 0.309<SUP>+0.163</SUP><SUB>&amp;minus;0.026</SUB> M<SUB>&#8857;</SUB> <mml:math> <mml:mrow> <mml:msub> <mml:mi>M</mml:mi> <mml:mi>c</mml:mi> </mml:msub> <mml:mo>=</mml:mo> <mml:mn>0</mml:mn> <mml:mo>.</mml:mo> <mml:msubsup> <mml:mn>309</mml:mn> <mml:mrow> <mml:mo>&amp;minus;</mml:mo> <mml:mn>0.026</mml:mn> </mml:mrow> <mml:mrow> <mml:mo>+</mml:mo> <mml:mn>0.163</mml:mn> </mml:mrow> </mml:msubsup> <mml:mspace></mml:mspace> <mml:msub> <mml:mi>M</mml:mi> <mml:mo>&#8857;</mml:mo> </mml:msub> </mml:mrow> </mml:math> </inline-formula>, an orbital inclination of i = 123&lpar;4&rpar;&#176;, and a longitude of the ascending node of &amp;Omega; = 334&lpar;12&rpar;&#176;. All uncertainties represent the 68.27&amp;percnt; credibility region. These results strongly favour a helium-dominated white dwarf companion.},

}
