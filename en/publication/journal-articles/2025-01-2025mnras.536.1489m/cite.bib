@article{2025MNRAS.536.1489M,

	year = {2025},

	volume = {536},

	title = {The MeerKAT Pulsar Timing Array: the first search for gravitational waves with the MeerKAT radio telescope},

	pages = {1489},

	month = {01},

	journal = {Monthly Notices of the Royal Astronomical Society},

	doi = {10.1093/mnras/stae2571},

	author = {Miles, Matthew T. and Shannon, Ryan M. and Reardon, Daniel J. and Bailes, Matthew and Champion, David J. and Geyer, Marisa and Gitika, Pratyasha and Grunthal, Kathrin and Keith, Michael J. and Kramer, Michael and Kulkarni, Atharva D. and Nathan, Rowina S. and Parthasarathy, Aditya and Singha, Jaikhomba and Theureau, Gilles and Thrane, Eric and Abbate, Federico and Buchner, Sarah and Cameron, Andrew D. and Camilo, Fernando and Moreschi, Beatrice E. and Shaifullah, Golam and Shamohammadi, Mohsen and Possenti, Andrea and Krishnan, Vivek Venkatraman},

	abstract = {Pulsar timing arrays search for nanohertz-frequency gravitational waves by regularly observing ensembles of millisecond pulsars over many years to look for correlated timing residuals. Recently the first evidence for a stochastic gravitational wave background has been presented by the major arrays, with varying levels of significance &lpar;<inline-formula><tex-math id=&amp;quot;TM0001&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;&lcub;&bsol;sim&rcub; 2&bsol;sigma &bsol;&amp;excl;-&bsol;&amp;excl; 4&bsol;sigma&amp;dollar;</tex-math></inline-formula>&rpar;. In this paper, we present the results of background searches with the MeerKAT Pulsar Timing Array. Although of limited duration &lpar;4.5 yr&rpar;, the <inline-formula><tex-math id=&amp;quot;TM0002&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;&lcub;&bsol;sim&rcub; 250&bsol;,000&amp;dollar;</tex-math></inline-formula> arrival times with a median error of just <inline-formula><tex-math id=&amp;quot;TM0003&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;3 &bsol;, &bsol;mu &lcub;&bsol;rm s&rcub;&amp;dollar;</tex-math></inline-formula> on 83 pulsars make it very sensitive to spatial correlations. Detection of a gravitational wave background requires careful modelling of noise processes to ensure that any correlations represent a fit to the underlying background and not other misspecified processes. Under different assumptions about noise processes, we can produce either what appear to be compelling Hellings-Downs correlations of high significance &lpar;<inline-formula><tex-math id=&amp;quot;TM0004&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;3&bsol;sigma &bsol;&amp;excl;-&bsol;&amp;excl; 3.4&bsol;sigma&amp;dollar;</tex-math></inline-formula>&rpar; with a spectrum close to that which is predicted, or surprisingly, under slightly different assumptions, ones that are insignificant. This appears to be related to the fact that many of the highest precision MeerKAT Pulsar Timing Array pulsars are in close proximity and dominate the detection statistics. The sky-averaged characteristic strain amplitude of the correlated signal in our most significant model is <inline-formula><tex-math id=&amp;quot;TM0005&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;h_&lcub;&lcub;&bsol;rm c&rcub;, &lcub;&bsol;rm yr&rcub;&rcub; = 7.5&Hat;&lcub;+0.8&rcub;_&lcub;-0.9&rcub; &bsol;times 10&Hat;&lcub;-15&rcub;&amp;dollar;</tex-math></inline-formula> measured at a spectral index of <inline-formula><tex-math id=&amp;quot;TM0006&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;&bsol;alpha =-0.26&amp;dollar;</tex-math></inline-formula>, decreasing to <inline-formula><tex-math id=&amp;quot;TM0007&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;h_&lcub;&lcub;&bsol;rm c&rcub;, &lcub;&bsol;rm yr&rcub;&rcub; = 4.8&Hat;&lcub;+0.8&rcub;_&lcub;-0.9&rcub; &bsol;times 10&Hat;&lcub;-15&rcub;&amp;dollar;</tex-math></inline-formula> when assessed at the predicted <inline-formula><tex-math id=&amp;quot;TM0008&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;&bsol;alpha =-2/3&amp;dollar;</tex-math></inline-formula>. These data will be valuable as the International Pulsar Timing Array project explores the significance of gravitational wave detections and their dependence on the assumed noise models.},

}
