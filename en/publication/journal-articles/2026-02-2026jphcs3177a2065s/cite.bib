@inproceedings{2026JPhCS3177a2065S,

	year = {2026},

	volume = {3177},

	title = {From a Rumble to a Roar: The International Pulsar Timing Array&apos;s Third Data Release},

	pages = {012065},

	month = {02},

	journal = {Journal of Physics Conference Series},

	doi = {10.1088/1742-6596/3177/1/012065},

	author = {Shaifullah, G. M.},

	abstract = {Pulsar Timing Arrays &lpar;PTAs&rpar; use the remarkable rotational stability of millisecond pulsars &lpar;MSPs&rpar; to detect nanohertz-frequency gravitational waves &lpar;GWs&rpar;. The International PTA &lpar;IPTA&rpar; combines datasets from six regional PTAs to form the most sensitive experiment to date, with the release of IPTA Data Release 3 &lpar;IPTA-DR3&rpar;. This dataset spans 130 pulsars, baselines up to 27 years, and frequency coverage from 30 to 5107 MHz, enabling precise characterisation of both the stochastic GW background &lpar;GWB&rpar;and potential continuous-wave &lpar;CGW&rpar; sources. We present an overview of IPTA-DR3 construction, including data combination pipelines, white and red noise modelling, and likelihood-based inference. We summarise current evidence for correlated GW signals and outline prospects for individual SMBHB detection, multi-messenger follow-up, and probing cosmological GW sources with next-generation PTAs.},

}
