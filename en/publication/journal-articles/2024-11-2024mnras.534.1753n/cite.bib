@article{2024MNRAS.534.1753N,

	year = {2024},

	volume = {534},

	title = {Periodicity search in the timing of the 25 millisecond pulsars from the second data release of the European Pulsar Timing Array},

	pages = {1753},

	month = {11},

	journal = {Monthly Notices of the Royal Astronomical Society},

	doi = {10.1093/mnras/stae2162},

	author = {Ni&#355;u, Iuliana C. and Keith, Michael J. and Champion, David J. and Cognard, Isma&amp;euml;l and Desvignes, Gregory and Guillemot, Lucas and Guo, Yanjun and Hu, Huanchen and Jang, Jiwoong and Jawor, Jedrzej and Karuppusamy, Ramesh and Keane, Evan F. and Kramer, Michael and Lackeos, Kristen and Liu, Kuo and Main, Robert A. and Perrodin, Delphine and Porayko, Nataliya K. and Shaifullah, Golam M. and Theureau, Gilles},

	abstract = {In this work, we investigated the presence of strictly periodic, as well as quasi-periodic signals, in the timing of the 25 millisecond pulsars &lpar;MSPs&rpar; from the European Pulsar Timing Array Second Data Release data set. This is especially interesting in the context of the recent hints of a gravitational wave background in these data, and the necessary further study of red noise timing processes, which are known to behave quasi-periodically in some normal pulsars. We used Bayesian timing models developed through the RUN_ENTERPRISE pipeline: a strict periodicity was modelled as the influence of a planetary companion on the pulsar, while a quasi-periodicity was represented as a Fourier-domain Gaussian process. We found that neither model would clearly improve the timing models of the 25 MSPs in this data set. This implies that noise and parameter estimates are unlikely to be biased by the presence of a &lpar;quasi-&rpar;periodicity in the timing data. Nevertheless, the results for PSRs J1744-1134 and J1012<inline-formula><tex-math id=&amp;quot;TM0001&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;+&amp;dollar;</tex-math></inline-formula>5307 suggest that the standard noise models for these pulsars may not be sufficient. We also measure upper limits for the projected masses of planetary companions around each of the 25 pulsars. The data of PSR J1909-3744 yielded the best mass limits, such that we constrained the 95 percentile to <inline-formula><tex-math id=&amp;quot;TM0002&amp;quot; notation=&amp;quot;LaTeX&amp;quot;>&amp;dollar;&bsol;sim &bsol;&amp;excl; 2 &bsol;times 10&Hat;&lcub;-4&rcub;&bsol;, &bsol;mathrm&lcub;M&rcub;_&lcub;&bsol;oplus &rcub;&amp;dollar;</tex-math></inline-formula> &lpar;roughly the mass of the dwarf planet Ceres&rpar; for orbital periods between 5 d and 17 yr. These are the best pulsar planet-mass limits to date.},

}
