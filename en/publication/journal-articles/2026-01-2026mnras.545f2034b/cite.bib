@article{2026MNRAS.545f2034B,

	year = {2026},

	volume = {545},

	title = {A glitch in the millisecond pulsar J0900&amp;minus;3144},

	pages = {staf2034},

	month = {01},

	journal = {Monthly Notices of the Royal Astronomical Society},

	doi = {10.1093/mnras/staf2034},

	author = {Bhat, Bhavnesh and Keith, Michael J. and Cognard, Isma&amp;euml;l and Guillemot, Lucas and Lower, Marcus E. and Miles, Matthew T. and Reardon, Daniel J. and Shaifullah, Golam and Shannon, Ryan M. and Stappers, Benjamin W. and Theureau, Gilles and Wang, Shuangqiang and Zic, Andrew and Shaw, Benjamin},

	abstract = {We report the detection of a glitch in the millisecond pulsar &lpar;MSP&rpar; PSR J0900&#9472;3144, which is included in the European, MeerKAT, and Parkes pulsar timing array &lpar;PTA&rpar; experiments. The data set combines observations from the MeerKAT, Nan&#231;ay, Lovell, and Murriyang telescopes, spanning a total baseline of approximately 14 yr. The glitch occurred on MJD 59942&lpar;17&rpar;, with a measured fractional spin frequency step of <inline-formula><tex-math>&amp;dollar;&bsol;Delta &bsol;nu _&lcub;&bsol;rm g&rcub; / &bsol;nu = 1.15&lpar;13&rpar; &bsol;times 10&Hat;&lcub;-12&rcub;&amp;dollar;</tex-math></inline-formula>. This event represents the third glitch detected in an MSP, following those in PSRs B1821&#9472;24A and J0613&#9472;0200. Although smaller in amplitude than the previous two, the glitch in PSR J0900&#9472;3144 is of a comparable order of magnitude. The updated MSP glitch rate is <inline-formula><tex-math>&amp;dollar;2.5&lpar;1&rpar;&bsol;times 10&Hat;&lcub;-3&rcub;&amp;dollar;</tex-math></inline-formula> glitches per pulsar per year, which suggests it is likely that current PTAs will detect another MSP glitch within 5 yr. Using simulations, we demonstrate that such small glitches can go undetected, especially in short data sets such as those from new PTAs, and can bias the inferred achromatic noise model parameters, potentially leading to the down-weighting of the pulsar in gravitational wave background searches.},

}
