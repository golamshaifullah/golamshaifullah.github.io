@article{2026A&A...710A..52C,

	year = {2026},

	volume = {710},

	title = {Pulsar scintillation studies with LOFAR: III. Annual variations in PSR J0814+7429},

	pages = {A52},

	month = {05},

	journal = {Astronomy and Astrophysics},

	doi = {10.1051/0004-6361/202557812},

	author = {Cai, Yanqing and Wu, Ziwei and Zhu, Weiwei and Verbiest, Joris P. W. and Liu, Yulan and Moochickal Ambalappat, Krishnakumar and Br&amp;uuml;ggen, Marcus and Ciardi, Benedetta and Dettmar, Ralf-J&amp;uuml;rgen and Fang, Ziyao and Fu, Qiuyang and Hoeft, Matthias and Jin, Jiawei and K&amp;uuml;nkel, Lars and K&amp;uuml;nsem&amp;ouml;ller, J&amp;ouml;rn and Liu, Caisong and Meng, Lingqi and Miao, Xueli and Niu, Jiarui and Rejep, Rukiya and Schwarz, Dominik J. and Shaifullah, Golam M. and Tiburzi, Caterina and Vocks, Christian and Wucknitz, Olaf and Xue, Mengyao and Yuan, Mao and Yue, Youling and Zhang, Chunfeng and Zhang, Zhen},

	abstract = {Context. The interstellar scintillation observed in radio pulsars arises from interference between electromagnetic waves scattered by electron density fluctuations in the turbulent interstellar plasma, providing a critical tool for probing the small-scale structure of the ionized interstellar medium and the pulsar system itself. Aims. The primary aim of this work is to study long-term scintillation variations for a bright and nearby pulsar, PSR J0814+7429, carried out from September 2013 to September 2023 with the LOw-Frequency ARray &lpar;LOFAR&rpar; High Band Antennae in the frequency range 120-170 MHz. Methods. We derived the basic scintillation parameters, scintillation bandwidth &lpar;&#8710;&amp;nu;<SUB>d</SUB>&rpar;, and scintillation timescale &lpar;&#8710;&amp;tau;<SUB>d</SUB>&rpar; from the twodimensional &lpar;2D&rpar; auto-covariance function of the dynamic spectra that are a 2D matrix of pulse intensity as a function of time and frequency. Results. We present a long-term monitoring study of &#8710;&amp;nu;<SUB>d</SUB> and &#8710;&amp;tau;<SUB>d</SUB> for PSR J0814+7429, which shows a strong annual variation in the time series of the &#8710;&amp;tau;<SUB>d</SUB>. From our modeling of the annual variations of scintillation velocities, the scattering screen is anisotropic and located at 0.23 &amp;plusmn; 0.02 kpc from the Earth, likely corresponding to the boundary of the Local Bubble.},

}
